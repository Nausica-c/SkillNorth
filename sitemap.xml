---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/clusters/' | absolute_url }}</loc></url>
  <url><loc>{{ '/guides/essential-skills-for-2027/' | absolute_url }}</loc></url>
  <url><loc>{{ '/articles/' | absolute_url }}</loc></url>
  {% for article in site.data.articles %}<url><loc>{{ article.url | absolute_url }}</loc></url>{% endfor %}
  {% for cluster in site.data.clusters %}<url><loc>{{ '/clusters/' | append: cluster.slug | append: '/' | absolute_url }}</loc></url>{% endfor %}
  <url><loc>{{ '/about/' | absolute_url }}</loc></url>
  <url><loc>{{ '/how-we-select/' | absolute_url }}</loc></url>
  <url><loc>{{ '/affiliate-disclosure/' | absolute_url }}</loc></url>
  <url><loc>{{ '/privacy/' | absolute_url }}</loc></url>
  <url><loc>{{ '/contact/' | absolute_url }}</loc></url>
</urlset>
